<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      An Exoforge plugin, and that is the whole declaration. The package below carries the SDK, the
      generator and the manifest plumbing, so this project builds from a feed wherever it is put -
      including with no Exoforge checkout anywhere near it, which is the point of the sample.
    -->
    <ExoforgePlugin>true</ExoforgePlugin>

    <!-- A native plugin is a process. Building it through the CLI overrides the build stamp. -->
    <ExoforgePluginType>native</ExoforgePluginType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inside the Exoforge repository the root Directory.Build.targets swaps this for the sources
         beside it, so an edit to the SDK lands in the next build here with nothing to sync. -->
    <!-- A literal, not a property: this project has to build with no Exoforge repository around it,
         which is the point of the sample. Bump it with Directory.Build.props's
         ExoforgePluginSdkVersion. -->
    <PackageReference Include="Exoforge.Plugin.SDK" Version="0.1.0" />
  </ItemGroup>

</Project>
