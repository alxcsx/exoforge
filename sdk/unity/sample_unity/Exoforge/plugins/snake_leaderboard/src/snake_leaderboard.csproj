<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      An Exoforge plugin, and that is the whole declaration. The repository's
      Directory.Build.targets supplies the SDK, the generator and the manifest plumbing, so nothing
      here names a path to another project - and the same file builds outside the repository, where
      the published package supplies the same three things.
    -->
    <ExoforgePlugin>true</ExoforgePlugin>

    <!-- A native plugin is a process. ExoDeployer overrides the build stamp per build. The manifest
         path is not set here: this is the scaffolded layout, so the default applies. -->
    <ExoforgePluginType>native</ExoforgePluginType>
  </PropertyGroup>

</Project>
