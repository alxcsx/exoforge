<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Exoforge extensions: nuget.org for runtime packs, plus the extension SDK packed in .feed. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="exoforge" value=".feed" />
  </packageSources>
</configuration>
