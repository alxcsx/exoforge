<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>

    <!-- The generator runs here, so this project is also the manifest generator's smoke test. -->
    <ExoforgePlugin>true</ExoforgePlugin>
    <ExoforgePluginType>native</ExoforgePluginType>

    <!--
      Relative on purpose. The generator writes wherever this points, and it runs inside the
      compiler, which does not start in the project directory - so a relative path is the one shape
      that can silently write somewhere else. `ManifestPath()` in the tests looks for exactly this
      file, which makes every test in the suite a check on it.
    -->
    <ExoforgeManifestPath>obj/Exoforge/manifest.exs</ExoforgeManifestPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The SDK and the generator come from Directory.Build.targets: this project declares itself a
       plugin and gets both, plus the manifest plumbing. The contracts project is its own thing. -->
  <ItemGroup>
    <ProjectReference Include="..\Exoforge.Plugin.Generator.Tests.Contracts\Exoforge.Plugin.Generator.Tests.Contracts.csproj" />
  </ItemGroup>

</Project>
