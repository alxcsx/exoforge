<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 only: plugins target net10.0 and consume this fine. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Exoforge.Plugin.SDK</RootNamespace>
    <AssemblyName>Exoforge.Plugin.SDK</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      1591: missing XML comment.
      IL2026/IL3050/IL2067: the reflection-based JSON and Activator fallbacks in Json.cs /
      PluginHost.cs. They are deliberate — source-generated contexts are the AOT path, these are
      the fallback for callers that do not supply one. The warnings belong here, not in every
      plugin author's build log, where they drown out warnings about their own code.
    -->
    <NoWarn>$(NoWarn);1591;IL2026;IL3050;IL2067</NoWarn>

    <!--
      Packable so a game developer outside this repository references the SDK from a feed instead of
      a path into someone else's checkout: `just pack-sdk`, or `dotnet pack` on this project.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Exoforge.Plugin.SDK</PackageId>
    <Version>$(ExoforgePluginSdkVersion)</Version>
    <Description>Author Exoforge game-backend plugins in C#. Attributes declare the contract; PluginHost runs them as a NativeAOT process.</Description>
    <PackageTags>exoforge;game-backend;plugins;nativeaot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Exoforge.Plugin.SDK.Tests" />
    <InternalsVisibleTo Include="Exoforge.Plugin.Generator.Tests" />
  </ItemGroup>

  <!--
    One package, not two. A plugin needs the attributes to compile against and the generator to
    write its manifest; shipping them together is what lets a plugin's project file be a single
    PackageReference with nothing else in it.
  -->
  <ItemGroup>
    <None Include="build/Exoforge.Plugin.SDK.targets" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>

  <Target Name="ExoforgePackGenerator"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="$(ExoforgeCSharpSdk)/Exoforge.Plugin.Generator/Exoforge.Plugin.Generator.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="ExoforgeGeneratorOutput" />
    </MSBuild>

    <!-- NuGet picks up analyzers/dotnet/cs without being told, which is why the location matters. -->
    <ItemGroup>
      <None Include="@(ExoforgeGeneratorOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
