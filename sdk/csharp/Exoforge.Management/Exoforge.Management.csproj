<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 only: consumable from net10.0, so a second target buys nothing. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Exoforge.Management</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <!-- Tools~ holds the manifest generator: a self-contained project that ships beside this one.
         It is not part of this assembly and must not be swept into its compile globs. -->
    <Compile Remove="Tools~/**" />
    <None Remove="Tools~/**" />
    <EmbeddedResource Remove="Tools~/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exoforge.Client\Exoforge.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
