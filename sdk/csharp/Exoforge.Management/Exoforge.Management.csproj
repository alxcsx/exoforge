<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>Exoforge.Management</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The management source lives in the Unity package, which is the unit of distribution and has
      to work as-is for a consumer. This project compiles those same files rather than a synced
      copy, so there is nothing to keep in step and nothing that can drift.
    -->
    <Compile Include="..\..\unity\Exoforge.SDK\Editor\Management\ExoDeployer.cs" Link="Management\ExoDeployer.cs" />
    <Compile Include="..\..\unity\Exoforge.SDK\Editor\Management\ExoWorkspace.cs" Link="Management\ExoWorkspace.cs" />
    <Compile Include="..\..\unity\Exoforge.SDK\Editor\Management\ExoScaffolder.cs" Link="Management\ExoScaffolder.cs" />
    <Compile Include="..\..\unity\Exoforge.SDK\Editor\Management\ExoCodeGenerator.cs" Link="Management\ExoCodeGenerator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exoforge.Client\Exoforge.Client.csproj" />
    <ProjectReference Include="..\Exoforge.Plugin.SDK\Exoforge.Plugin.SDK.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
