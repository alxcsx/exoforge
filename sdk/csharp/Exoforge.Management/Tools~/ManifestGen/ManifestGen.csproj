<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generates manifest.exs from a plugin assembly.

    Deliberately has no ProjectReference or PackageReference: it reads the Exoforge attribute
    values straight out of the assembly's metadata by name, so it can be `dotnet run` from
    anywhere — including out of the packaged SDK — with nothing to restore.

    Lives under Tools~ so Unity ignores the folder; ExoDeployer finds it next to the SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Exoforge.ManifestGen</AssemblyName>
    <RootNamespace>Exoforge.ManifestGen</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
