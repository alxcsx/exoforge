<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Exoforge.CLI</RootNamespace>
    <AssemblyName>exo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The manifest generator ships beside the CLI, so a native plugin build finds it without
      knowing anything about the layout it was installed into.
    -->
    <None Include="..\..\unity\Exoforge.SDK\Editor\Management\Tools~\ManifestGen\Program.cs"
          Link="Tools~\ManifestGen\Program.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\unity\Exoforge.SDK\Editor\Management\Tools~\ManifestGen\ManifestGen.csproj"
          Link="Tools~\ManifestGen\ManifestGen.csproj"
          CopyToOutputDirectory="PreserveNewest" />

    <ProjectReference Include="..\Exoforge.Management\Exoforge.Management.csproj" />
    <!-- Referenced directly: ExoDeployer's API exposes ExoClient (e.g. VerifyPluginAsync's
         optional parameter), so compiling a call to it needs the assembly. Warm builds hid
         this; a cold clone failed with CS0012. -->
    <ProjectReference Include="..\Exoforge.Client\Exoforge.Client.csproj" />
  </ItemGroup>
</Project>
