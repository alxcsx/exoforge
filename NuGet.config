<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      The local feed `just pack-sdk` fills, so a plugin built outside this repository restores
      Exoforge.Plugin.SDK without anyone having to remember a `dotnet nuget add source` on their
      machine. A source that is not there yet is skipped, so a fresh clone restores from nuget.org
      as usual until the first `just pack-sdk`.
    -->
    <add key="exoforge-local" value="dist/nuget" />
  </packageSources>
</configuration>
