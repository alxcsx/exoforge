# === Elixir & BEAM Build Artifacts ===
# Since all sub-projects share the root directories, this catches everything
/_build/
/cover/
/deps/
/doc/
/*.ez
/*.beam
/erl_crash.dump
/mix.lock
exoforge-*.tar

# === Development Environment & IDEs ===
# Language Server artifacts (ElixirLS / Lexical / NextLS)
/.elixir_ls/
/.lexical/
/.nextls/
.fetch

# Code Editor Specifics
/.idea/
/.vscode/
/.zed/
*.swp
*~

# === Test & Coverage Reports ===
/cover/
/.htmlcov/
/log/*.log

# === ExoForge Engine Specifics ===
# Ignore compiled release binaries or target runtime packages if generated locally
/priv/static/components/

# === Environment & Secrets ===
# Ignore local environment variable overrides
.env
.env.local
.env.*.local
