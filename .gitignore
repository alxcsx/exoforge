# === Elixir & BEAM Build Artifacts ===
_build/
deps/
_deps/
cover/
doc/
*.dets
*.ez
*.beam
erl_crash.dump
exoforge-*.tar

# === .NET Build Artifacts ===
bin/
obj/
dist/

# === Development Environment & IDEs ===
.pi/
.elixir_ls/
.lexical/
.nextls/
.fetch
.idea/
.vscode/
.zed/
*.swp
*~
# The Unity package ships the engine-agnostic C# libraries as binaries, built by
# `just build-unity-sdk`. Build output: a committed DLL is a copy that can silently go stale, which
# is the same failure a synced source file has.
sdk/unity/Exoforge.SDK/*/Plugins/

# `*~` also matches the SDK's Unity-ignored Tools~ and Samples~ directories; keep those tracked.
!**/Samples~/
!**/Tools~/
!**/Tools~

# The sample's copy of the Unity package, placed by `just unity-sync`. The sample names no path
# outside itself, so the package is copied in - and being a copy, it is output, not source.
sdk/unity/sample_unity/Packages/com.exoforge.sdk/

# === Test & Coverage Reports ===
.htmlcov/
log/*.log

# === ExoForge Engine Specifics ===
priv/data/

# Plugin build outputs: the manifest, the build counter and the staged binary. All three are
# produced by `exo plugin build` / the Control Center, and the manifest carries the build counter,
# so tracking them means a diff on every build.
.buildcount
.exoforge/

# The generator writes the same contracts as JSON beside the manifest, for the C# tooling to read.
# Not `manifest.json` unqualified: a Unity project's Packages/manifest.json is source.
sdk/unity/sample_unity/Exoforge/plugins/*/manifest.json
plugins_csharp/*/manifest.json

# === Environment & Secrets ===
.env
.env.local
.env.*.local
.envrc
.envrc.local

# === Unity Engine Artifacts ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
MemoryCaptures/
Recordings/

# ...except a NuGet package's build/ folder, which is content rather than output: it is the file
# NuGet imports into every project that references the package. `[Bb]uild/` above would otherwise
# ignore it silently, and the package would be published without it.
!sdk/csharp/Exoforge.Plugin.SDK/build/
!sdk/csharp/Exoforge.Plugin.SDK/build/**

# === Unity-generated IDE project files (regenerated on import) ===
sdk/unity/sample_unity/*.csproj
sdk/unity/sample_unity/*.slnx

# Unity/Mono crash dumps.
sdk/unity/sample_unity/mono_crash.*

# Whatever `-runTests` was last told to write. The Justfile points it at /tmp; an editor run does
# not, and drops the file next to the project.
sdk/unity/sample_unity/TestResults*.xml
sdk/unity/sample_unity/*.log
