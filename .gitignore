[Uu]serSettings/
MemoryCaptures/
Recordings/

# === Unity-generated IDE project files (regenerated on import) ===
sdk/unity/sample_unity/*.csproj
sdk/unity/sample_unity/*.slnx

# Unity/Mono crash dumps.
sdk/unity/sample_unity/mono_crash.*.json
