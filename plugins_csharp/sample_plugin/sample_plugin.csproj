<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>

    <!--
      An Exoforge plugin, and that is the whole declaration. The repository's
      Directory.Build.targets supplies the SDK, the generator and the manifest plumbing, so nothing
      here names a path to another project.
    -->
    <ExoforgePlugin>true</ExoforgePlugin>

    <!-- The manifest lives at the project root, beside the published binary, which is where the
         runner looks for it. -->
    <ExoforgePluginType>native</ExoforgePluginType>
    <ExoforgeManifestPath Condition="'$(ExoforgeManifestPath)' == ''">$(MSBuildProjectDirectory)/manifest.json</ExoforgeManifestPath>
  </PropertyGroup>

</Project>
